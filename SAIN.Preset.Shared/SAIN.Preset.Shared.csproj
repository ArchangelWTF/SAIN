<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>SAIN.Preset.Shared</RootNamespace>
    <AssemblyName>SAIN.Preset.Shared</AssemblyName>
  </PropertyGroup>
  <Target Name="GenerateVersionInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <VersionInfoFile>$(IntermediateOutputPath)SAINCompileConstants.g.cs</VersionInfoFile>
    </PropertyGroup>
    <ItemGroup>
      <VersionInfoLines Include="// &lt;auto-generated /&gt; Generated by the GenerateVersionInfo build target." />
      <VersionInfoLines Include="namespace SAIN.Preset.Shared" />
      <VersionInfoLines Include="{" />
      <VersionInfoLines Include="    public static class SAINCompileConstants" />
      <VersionInfoLines Include="    {" />
      <VersionInfoLines Include="        public const string SAIN_VERSION = &quot;$(VersionPrefix)&quot;%3B" />
      <VersionInfoLines Include="        public const string SAIN_FULL_VERSION = &quot;$(Version)&quot;%3B" />
      <VersionInfoLines Include="        public const string SPT_VERSION = &quot;$(SptVersion)&quot;%3B" />
      <VersionInfoLines Include="    }" />
      <VersionInfoLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(VersionInfoFile)" Lines="@(VersionInfoLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(VersionInfoFile)" />
      <FileWrites Include="$(VersionInfoFile)" />
    </ItemGroup>
  </Target>
</Project>
